<?xml version="1.0" encoding="utf-8"?>
<!-- Pod-Pod: Material 3 colour roles for the "Pod-Pod Dynamic" themes (podpod_themes.xml). -->
<!-- API 31-33: wallpaper tonal palettes. Same palettes as material3 dynamicLight/DarkColorScheme on these APIs;
     tones the system does not ship (98, 96, 94, 92, 6, 12, 17, 22) use the nearest shipped tone. -->
