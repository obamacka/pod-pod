<?xml version="1.0" encoding="utf-8"?>
<!-- Pod-Pod: "Pod-Pod Dynamic" Material You themes (Theme.ThemeType.PODPOD_DYNAMIC_LIGHT / _DARK).
     They inherit every upstream token from ThemeLight / ThemeDark and override the neutral and accent tokens
     with Material 3 colour roles (podpod_m3_colors.xml): wallpaper colours on API 31+, a static fallback below. -->
<resources>

    <style name="PodPodDynamicLight" parent="ThemeLight">
        <!-- Token -> Material 3 role. Keep in sync with toPodPodThemeColors() in compose/.../podpod/PodPodColorSchemes.kt -->
        <item name="primary_ui_01">@color/podpod_m3_light_surface</item>
        <item name="primary_ui_01_active">@color/podpod_m3_light_surface_container</item>
        <item name="primary_ui_02">@color/podpod_m3_light_surface_container_low</item>
