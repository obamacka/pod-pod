        <item name="shapeAppearanceMediumComponent">@style/PodPod.ShapeAppearance.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/PodPod.ShapeAppearance.Large</item>
        <item name="materialButtonStyle">@style/PodPod.Widget.Button</item>
        <!-- Expressive navigation bar: pill active indicator (activity_main.xml uses ?attr/bottomNavigationStyle) -->
        <item name="bottomNavigationStyle">@style/PodPod.Widget.BottomNavigationView</item>
    </style>

