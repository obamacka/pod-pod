        <item name="bottomNavigationStyle">@style/PodPod.Widget.BottomNavigationView</item>
    </style>

    <!-- Expressive shape scale: cards/dialogs 16dp, sheets 28dp (M3 extra large), buttons full -->
    <style name="PodPod.ShapeAppearance.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="PodPod.ShapeAppearance.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="PodPod.ShapeAppearance.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="PodPod.Widget.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/PodPod.ShapeAppearance.Full</item>
    </style>

    <!-- Material 3 Expressive navigation bar, built on the Material Components style the app already uses
         (Widget.Material3* styles need M3 theme attributes these themes do not define): 64dp bar,
         56x32dp full-round active indicator in the secondary container colour. -->
    <style name="PodPod.Widget.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="activeIndicatorLabelPadding">4dp</item>
        <item name="itemActiveIndicatorStyle">@style/PodPod.Widget.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="PodPod.Widget.BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/PodPod.ShapeAppearance.Full</item>
        <item name="android:color">?attr/primary_ui_02_selected</item>
    </style>

</resources>
