        <item name="primary_ui_03">@color/podpod_m3_light_surface_container</item>
        <item name="primary_ui_04">@color/podpod_m3_light_surface</item>
        <item name="primary_ui_05">@color/podpod_m3_light_outline_variant</item>
        <item name="primary_ui_05_selected">@color/podpod_m3_light_outline</item>
        <item name="primary_ui_06">@color/podpod_m3_light_surface_container_high</item>
        <item name="primary_icon_01">@color/podpod_m3_light_primary</item>
