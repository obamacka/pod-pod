        <item name="primary_icon_03">@color/podpod_m3_light_on_surface_variant</item>
        <item name="primary_icon_03_active">@color/podpod_m3_light_primary</item>
        <item name="primary_text_01">@color/podpod_m3_light_on_surface</item>
        <item name="primary_text_02">@color/podpod_m3_light_on_surface_variant</item>
        <item name="primary_text_02_selected">@color/podpod_m3_light_primary</item>
        <item name="primary_field_01">@color/podpod_m3_light_surface_container_highest</item>
        <item name="primary_field_01_active">@color/podpod_m3_light_surface_variant</item>
        <item name="primary_field_02">@color/podpod_m3_light_surface_container_low</item>
        <item name="primary_field_02_active">@color/podpod_m3_light_surface_container_lowest</item>
        <item name="primary_field_03">@color/podpod_m3_light_outline</item>
        <item name="primary_field_03_active">@color/podpod_m3_light_primary</item>
        <item name="primary_interactive_01">@color/podpod_m3_light_primary</item>
        <item name="primary_interactive_01_hover">@color/podpod_m3_light_primary</item>
        <item name="primary_interactive_01_active">@color/podpod_m3_light_inverse_primary</item>
        <item name="primary_interactive_01_disabled">@color/podpod_m3_light_outline_variant</item>
        <item name="primary_interactive_02">@color/podpod_m3_light_on_primary</item>
        <item name="primary_interactive_02_hover">@color/podpod_m3_light_surface_container_high</item>
        <item name="primary_interactive_02_active">@color/podpod_m3_light_secondary_container</item>
        <item name="primary_interactive_03">@color/podpod_m3_light_outline_variant</item>
        <item name="secondary_ui_01">@color/podpod_m3_light_surface</item>
        <item name="secondary_ui_02">@color/podpod_m3_light_outline_variant</item>
        <item name="secondary_icon_01">@color/podpod_m3_light_on_surface_variant</item>
        <item name="secondary_icon_02">@color/podpod_m3_light_outline</item>
        <item name="secondary_text_01">@color/podpod_m3_light_on_surface</item>
        <item name="secondary_text_02">@color/podpod_m3_light_on_surface_variant</item>
        <item name="secondary_field_01">@color/podpod_m3_light_surface_container_highest</item>
        <item name="secondary_field_01_active">@color/podpod_m3_light_surface_variant</item>
        <item name="secondary_interactive_01">@color/podpod_m3_light_primary</item>
        <item name="secondary_interactive_01_hover">@color/podpod_m3_light_primary</item>
        <item name="secondary_interactive_01_active">@color/podpod_m3_light_inverse_primary</item>
        <item name="support_01">@color/podpod_m3_light_primary</item>
        <item name="support_03">@color/podpod_m3_light_primary</item>
        <item name="support_05">@color/podpod_m3_light_error</item>
